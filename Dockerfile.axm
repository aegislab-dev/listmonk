# Both frontend builds are packed into the Go binary by make dist (stuffbin).
FROM node:24.22.2-bookworm-slim AS node

FROM golang:1.26.1-bookworm AS build
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global yarn@1.22.22

WORKDIR /src
COPY . .
ENV CYPRESS_INSTALL_BINARY=0
RUN cd frontend && yarn install --frozen-lockfile \
    && cd email-builder && yarn install --frozen-lockfile

ARG VERSION
ARG COMMIT
RUN test -n "$VERSION" && test -n "$COMMIT" \
    && make dist VERSION="$VERSION" LAST_COMMIT="$COMMIT" \
    && ./listmonk --version

FROM alpine:3.23.4
RUN apk --no-cache add ca-certificates tzdata shadow su-exec
WORKDIR /listmonk
COPY --from=build /src/listmonk .
COPY config.toml.sample config.toml
COPY LICENSE README.md FORK.md ./
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./listmonk"]
