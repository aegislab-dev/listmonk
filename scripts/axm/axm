# ---------------------------------------------------------------- 환경

def env_int(name, default):
    try:
        return int(os.environ.get(name, default))
    except ValueError:
        return default


def cache_dir():
    return Path(os.environ.get('AXM_CACHE') or Path.home() / '.cache' / 'listmonk-axm')


def tmp_dir():
    base = os.environ.get('TMPDIR') or '/tmp'
    p = Path(base) / 'axm'
    p.mkdir(parents=True, exist_ok=True)
    return p


def cpus():
    return env_int('AXM_CPUS', 4)


def slots():
    return max(1, env_int('AXM_SLOTS', 2))


def git(*args, check=True, cwd=None, input=None):
    r = subprocess.run(['git', '-C', str(cwd or ROOT), *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise SystemExit(f'git {" ".join(args)} 실패: {r.stderr.strip()}')
    return r.stdout


def branch_name():
    return git('rev-parse', '--abbrev-ref', 'HEAD', check=False).strip()


class Ctx:
    """역할(agent|reviewer)별 이름·포트·표시 번호. 다른 태스크·리뷰어와 겹치지 않게 번호에서 만든다."""

    def __init__(self, role=None):
        self.role = role or os.environ.get('AXM_ROLE') or 'agent'
        if self.role not in ('agent', 'reviewer'):
            raise SystemExit('--role 은 agent 또는 reviewer')
        m = re.match(r'work/(\d+)-', branch_name())
        task = os.environ.get('AXM_TASK') or (m.group(1) if m else '')
        if not task.isdigit():
            raise SystemExit('태스크 번호를 못 찾았다: 브랜치가 work/<N>-… 이거나 AXM_TASK=<N> 을 준다.')
        self.n = int(task)
        rv = 1 if self.role == 'reviewer' else 0
        self.prefix = f'axm{self.n}{"r" if rv else ""}'
        base = 41000 + (self.n % 300) * 20 + rv * 10
        self.pg_port = free_port(base)
        self.app_port = free_port(base + 1, avoid={self.pg_port})
        self.display = 100 + (self.n % 150) * 2 + rv
        self.run = tmp_dir() / f'{self.prefix}'
        self.run.mkdir(parents=True, exist_ok=True)

    def name(self, what):
        return f'{self.prefix}-{what}'


def free_port(p, avoid=()):
    busy = set(avoid)
    r = subprocess.run(['ss', '-ltnH'], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        m = re.search(r':(\d+)\s', line)
        if m:
            busy.add(int(m.group(1)))
    while p in busy:
        p += 1
    return p


# ---------------------------------------------------------------- 표시·기록

OUT = [sys.stdout]


def say(msg=''):
    print(msg, file=OUT[0], flush=True)


def fmt_s(x):
    if x is None:
        return '-'
    if x >= 60:
        return f'{int(x // 60)}m{int(x % 60):02d}s'
    return f'{x:.1f}s'


class Steps:
    """단계별 시간·CPU초 기록. 표로 낸다."""

    def __init__(self, ctx=None, tag=''):
        self.rows = []
        self.ctx = ctx
        self.tag = tag
        self.load1 = os.getloadavg()[0]

    def add(self, stage, wall, cpu, peak=None, note='', rc=0, waited=0.0):
        row = dict(stage=stage, wall=wall, cpu=cpu, peak=peak, note=note, rc=rc, waited=waited)
        self.rows.append(row)
        rec = dict(ts=int(time.time()), task=self.ctx.n if self.ctx else None, role=self.ctx.role if self.ctx else None,
                   tag=self.tag, load1=round(self.load1, 2), **row)
        try:
            c = cache_dir()
            c.mkdir(parents=True, exist_ok=True)
            with open(c / 'metrics.jsonl', 'a') as f:
                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
        except OSError:
            pass

    def table(self, title='단계별 시간·CPU'):
        out = [f'\n== {title} (시작 때 load average {self.load1:.1f}) ==',
               f'{"단계":<34}{"벽시계":>9}{"CPU초":>9}{"최대코어":>9}  비고']
        tw = tc = 0.0
        for r in self.rows:
            if not r['stage'].startswith('  ') or r['stage'].startswith('  ('):  # 들여쓴 줄은 위 줄의 내역이라 합계에서 뺀다
                tw += r['wall'] or 0
                tc += r['cpu'] or 0
            pk = '-' if r['peak'] is None else f'{r["peak"]:.1f}'
            cp = '-' if r['cpu'] is None else f'{r["cpu"]:.1f}'
            note = r['note'] + (f' (대기 {fmt_s(r["waited"])})' if r['waited'] > 1 else '') + ('' if r['rc'] == 0 else ' 실패')
            out.append(f'{r["stage"]:<34}{fmt_s(r["wall"]):>9}{cp:>9}{pk:>9}  {note}')
        out.append(f'{"합계":<34}{fmt_s(tw):>9}{tc:>9.1f}')
        return '\n'.join(out)


# ---------------------------------------------------------------- cgroup CPU

def scope_dir(cid):
    return Path(f'/sys/fs/cgroup/system.slice/docker-{cid}.scope')


def read_usage(cid):
    try:
        for line in (scope_dir(cid) / 'cpu.stat').read_text().splitlines():
            if line.startswith('usage_usec'):
                return int(line.split()[1]) / 1e6
    except (OSError, ValueError):
        pass
    return None


def container_id(name):
    r = subprocess.run(['docker', 'inspect', '-f', '{{.Id}}', name], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


class Poller(threading.Thread):
    """컨테이너 이름을 기다렸다가 cgroup 의 CPU 사용량을 0.4초마다 읽는다."""

    def __init__(self, name=None, cid=None, interval=0.4):
        super().__init__(daemon=True)
        self.name_, self.cid, self.interval = name, cid, interval
        self.samples = []
        self.stop = threading.Event()

    def run(self):
        while not self.stop.is_set() and self.cid is None:
            self.cid = container_id(self.name_)
            if self.cid is None:
                self.stop.wait(0.2)
        while not self.stop.is_set():
            u = read_usage(self.cid)
            if u is not None:
                self.samples.append((time.time(), u))
            self.stop.wait(self.interval)

    def finish(self):
        self.stop.set()
        self.join(timeout=3)

    def last(self):
        return self.samples[-1][1] if self.samples else None

    def peak(self, window=2.0):
        s, best = self.samples, 0.0
        j = 0
        for i in range(len(s)):
            while s[i][0] - s[j][0] > window:
                j += 1
            dt = s[i][0] - s[j][0]
            if dt >= 0.5:
                best = max(best, (s[i][1] - s[j][1]) / dt)
        return best or None


# ---------------------------------------------------------------- 잠금·칸

class Slot:
    """무거운 단계(빌드·Go 시험·Cypress)가 동시에 AXM_SLOTS 개만 돌게 하는 칸."""

    def __enter__(self):
        d = cache_dir() / 'locks'
        d.mkdir(parents=True, exist_ok=True)
        t0, told = time.time(), False
        while True:
            for i in range(1, slots() + 1):
                f = open(d / f'slot-{i}', 'w')
                try:
                    fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    self.f, self.waited = f, time.time() - t0
                    return self
                except BlockingIOError:
                    f.close()
            if not told:
                say(f'무거운 단계 칸이 모두 사용 중이다(AXM_SLOTS={slots()}). 기다린다…')
                told = True
            time.sleep(3)

    def __exit__(self, *a):
        self.f.close()


class FileLock:
    def __init__(self, name):
        d = cache_dir() / 'locks'
        d.mkdir(parents=True, exist_ok=True)
        self.path = d / name

    def __enter__(self):
        self.f = open(self.path, 'w')
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


# ---------------------------------------------------------------- 파일·해시

def tree_files():
    out = git('ls-files', '-co', '--exclude-standard', '-z').split('\0')
    return sorted(p for p in out if p and (ROOT / p).is_file())


def hash_files(paths):
    if not paths:
        return {}
    out = subprocess.run(['git', '-C', str(ROOT), 'hash-object', '--stdin-paths'], input='\n'.join(paths) + '\n',
                         capture_output=True, text=True).stdout.split()
    return dict(zip(paths, out))


def glob_re(pat):
    out, i = '', 0
    while i < len(pat):
        c = pat[i]
        if pat.startswith('**/', i):
            out += '(?:.*/)?'
            i += 3
            continue
        if pat.startswith('**', i):
            out += '.*'
            i += 2
            continue
        out += '[^/]*' if c == '*' else ('[^/]' if c == '?' else re.escape(c))
        i += 1
    return re.compile('^' + out + '$')


def match_any(path, pats):
    return any(glob_re(p).match(path) for p in pats)


def digest(*parts):
    h = hashlib.sha256()
    for p in parts:
        h.update(p if isinstance(p, bytes) else str(p).encode())
        h.update(b'\0')
    return h.hexdigest()


def key_of(paths, hashes):
    return digest(*[f'{p}={hashes[p]}' for p in sorted(paths)])[:16]


