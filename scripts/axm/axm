    t0 = time.time()
    with Slot():
        b = docker_build(ctx, 'runtime', ['-t', tag], rt)  # -q 를 쓰면 단계 줄이 없어 CPU 를 못 잰다
    if b['rc'] != 0:
        raise StageFailed(f'런타임 이미지 빌드 실패: {b["log"]}')
    steps.add('런타임 이미지', time.time() - t0, b['cpu'], note=b['note'] + ' (COPY 는 dockerd 몫, 미측정)')
    return tag


