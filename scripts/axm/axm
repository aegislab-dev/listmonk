def cmd_check(a):
    ctx = Ctx(a.role)
    steps = Steps(ctx, 'check')
    files = tree_files()
    hashes = hash_files(files)
    changed, res, st = select_tests(a, ctx, files, hashes)
    specs, go_pkgs = res['specs'], res['go']
    say(f'바뀐 파일 {len(changed)}개 → spec {len(specs)}개, Go 패키지 {len(go_pkgs)}개'
        + (', 프론트 단위시험' if res['unit'] else '') + (', 파이썬 시험' if res['python'] else ''))
    for n in res['notes']:
        say('주의: ' + n)
    failed_specs, failed_go = [], {}
    go_ran = e2e_ran = False
    ok = True
    pg = Pg(ctx)
    t_all = time.time()
    try:
        if res['python']:
            t0 = time.time()
            r = subprocess.run([sys.executable, '-m', 'unittest', 'scripts/axm/test_axm.py'], cwd=ROOT, capture_output=True, text=True)
            steps.add('파이썬 시험(scripts/axm)', time.time() - t0, None, rc=r.returncode)
            if r.returncode != 0:
                say(r.stderr[-1500:])
                ok = False
        if go_pkgs:
            pg.start()
            failed_go = go_test(ctx, steps, go_pkgs, pg)
            go_ran = True
            if failed_go:
                ok = False
        tag = None
        if specs:
            tag = ensure_test_image(ctx, steps, files, hashes)
            if not pg.up:
                pg.start()
            good, passed, failed_specs = e2e(ctx, steps, specs, tag, pg, profile=a.profile)
            e2e_ran = True
            if not good:
                ok = False
                if not failed_specs:
                    failed_specs = list(specs)
        elif res['unit']:
            ensure_test_image(ctx, steps, files, hashes, unit_only=True)
        if res['full_build'] and a.full_build:
            build_full(ctx, steps)
    except StageFailed as e:
        say(str(e))
        ok = False
    finally:
        pg.stop()
        for n in ('app', 'cy', 'go', 'build'):
            docker('rm', '-f', ctx.name(n), check=False)
    say(steps.table('이번 검사'))
    if not specs and not go_pkgs and not res['unit'] and not res['python']:
        say('돌릴 시험이 없다(문서만 바뀜 등).')
    # 통과 기록
    if ok:
        save_stamp(ctx, dict(ts=int(time.time()), branch=branch_name(), files=hashes, failed_specs=[], failed_go={},
                             ran_specs=specs, ran_go=sorted(go_pkgs)))
        say('통과 기록을 남겼다. 리뷰 재라운드·수정 뒤에는 `axm check --since-last`.')
    else:
        old = st or dict(ts=int(time.time()), branch=branch_name())
        old['failed_specs'], old['failed_go'] = failure_record(st, specs, failed_specs, e2e_ran, go_pkgs, failed_go, go_ran, files)
        save_stamp(ctx, old)
        say('실패 — 통과 기록은 갱신하지 않았다. 지난번에 실패한 시험은 다음 --since-last 에서도 다시 돈다.')
    say('\nCI 에 맡기는 것: 나머지 CI spec 전체와 운영 방식(Dockerfile.axm) 이미지 빌드·smoke(PR 의 axm-image).')
    return 0 if ok else 1


def failure_record(st, specs, failed_specs, e2e_ran, go_pkgs, failed_go, go_ran, files):
    """실패 기록: 이번에 실패한 것 + 지난번 실패했는데 이번에 돌지 못한 것. 이번에 통과한 것과 지워진 패키지는 뺀다."""
    prev_specs = set((st or {}).get('failed_specs') or [])
    prev_go = live_failed_go(st or {}, files)
    out_specs = set(failed_specs) | (prev_specs - set(specs) if e2e_ran else prev_specs)
    out_go = dict(failed_go)
    for d, r in prev_go.items():
        if d not in out_go and not (go_ran and d in go_pkgs):
            out_go[d] = r
    return [x for x in load_map()['ci_specs'] if x in out_specs], out_go


PARTS_SH = r'''
set -uo pipefail
%(mark_fn)s
export HOME=/tmp GOCACHE=/gocache GOMODCACHE=/gomod GOFLAGS=-buildvcs=false CYPRESS_INSTALL_BINARY=0 \
       GOPATH=/tmp/gopath CGO_ENABLED=0 CI=1
unset STUFFBIN   # Makefile 기본값 $(GOPATH)/bin/stuffbin = 비어 있는 /tmp/gopath/bin 에 make 가 직접 설치한다
cd /src
tar -C /work --null -T /axmctx/files.lst -cf - | tar -xf - || { echo "AXM_FAIL copy"; exit 1; }
rm -rf frontend/node_modules frontend/email-builder/node_modules || { echo "AXM_FAIL rm"; exit 1; }   # 지금 방식처럼 아무것도 없는 상태에서 시작
[ ! -e /tmp/gopath/bin/stuffbin ] && [ ! -e frontend/node_modules ] || { echo "AXM_FAIL clean-state"; exit 1; }
MK='VERSION=%(version)s LAST_COMMIT=%(commit)s'
run() { n=$1; shift; mark $n:start; "$@"; rc=$?; mark $n:end; [ $rc = 0 ] || { echo "AXM_FAIL $n"; exit $rc; }; }
run yarn_frontend  bash -c 'cd frontend && yarn install --frozen-lockfile'
run yarn_emailbuilder bash -c 'cd frontend/email-builder && yarn install --frozen-lockfile'
run unit bash -c 'cd frontend && yarn test:unit'
run gotest_compile go test -count=1 -run '^$' ./...
run stuffbin_install make /tmp/gopath/bin/stuffbin
[ -x /tmp/gopath/bin/stuffbin ] || { echo "AXM_FAIL stuffbin-missing"; exit 1; }
run eb make build-email-builder $MK
run fe make build-frontend $MK
run gobuild make build $MK
run pack make pack-bin $MK
'''


def measure_parts(ctx, steps):
    """지금 방식의 하위 단계를 따로 잰다(캐시·node_modules·stuffbin 없는 상태): yarn ×2, 단위시험, Go 시험 컴파일, 이메일 빌더, 프론트, go build, 패킹."""
    files = tree_files()
    base = ensure_base(ctx, steps)
    ctxdir = ctx.run / 'ctx'
    ctxdir.mkdir(parents=True, exist_ok=True)
    (ctxdir / 'files.lst').write_bytes(b'\0'.join(f.encode() for f in files if not f.startswith('docs/')) + b'\0')
    commit = git('rev-parse', '--short', 'HEAD', check=False).strip() or 'local'
    (ctxdir / 'parts.sh').write_text(PARTS_SH % dict(mark_fn=MARK_FN, version=LOCAL_VERSION, commit=commit))
    cold = ctx.run / f'parts-go-{os.getpid()}'
    (cold / 'gomod').mkdir(parents=True)
    (cold / 'gocache').mkdir(parents=True)
    dargs = ['--network', 'host', *limit_args(), '--user', f'{UID}:{GID}', '-v', f'{ROOT}:/work:ro',
             '-v', f'{cold / "gomod"}:/gomod', '-v', f'{cold / "gocache"}:/gocache', '-w', '/src']
    with Slot() as sl:
        res = run_container(ctx, 'parts', ctx.name('parts'), dargs + [base], ['bash', '/axmctx/parts.sh'], log_name='parts',
                            tee_filter=lambda l: l.startswith('AXM_FAIL'))
    subprocess.run(['chmod', '-R', 'u+w', str(cold)])  # Go 모듈 캐시는 읽기 전용으로 만들어진다
    shutil.rmtree(cold, ignore_errors=True)
    steps.add('분해 측정 컨테이너 전체', res['wall'], res['cpu'], res['peak'], rc=res['rc'], waited=sl.waited)
    for nm, wall, cpu in marks_to_rows(res):
        steps.add('  ' + nm, wall, cpu)
    if res['rc'] != 0:
        raise StageFailed('분해 측정 실패: ' + str(res['log']))


def cmd_measure(a):
    """기준선 측정: 지금 방식(캐시 없는 Dockerfile.axm 빌드, 전체 Go 시험, CI 의 13개 spec)을 단계별로 잰다."""
    ctx = Ctx(a.role)
    steps = Steps(ctx, 'measure-baseline')
    os.environ['AXM_CPUS'] = '0'  # 지금 방식은 CPU 한도가 없다
    tmap = load_map()
    pg = Pg(ctx)
    ok = True
    try:
        if a.parts:
            measure_parts(ctx, steps)
            say(steps.table('지금 방식의 하위 단계(빈 캐시)'))
            return 0
        say('1) 지금 방식: docker build -f Dockerfile.axm (legacy builder)')
        tag = build_full(ctx, steps)
        if a.build_only:
            say(steps.table())
            return 0
        pg.start()
        say('2) 전체 Go 시험(DB 포함, 캐시 없는 Go 캐시)')
        cold = ctx.run / 'cold-go'
        shutil.rmtree(cold, ignore_errors=True)
        cold.mkdir(parents=True)
        os.environ['AXM_GO_CACHE'] = str(cold)
        pkgs = {d: None for d, fs in go_packages(tree_files())[0].items() if any(f.endswith('_test.go') for f in fs)}
        ok = not go_test(ctx, steps, pkgs, pg, tag='전체') and ok
        say(f'3) CI 의 {len(tmap["ci_specs"])}개 spec')
