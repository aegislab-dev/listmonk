        steps.add('시험 이미지', 0, 0, note=f'있음 {key[:8]} — 건너뜀')
        return tag
    # 같은 입력을 두 태스크가 동시에 만들지 않게 한다(뒤에 온 쪽은 앞쪽이 끝나길 기다렸다가 이미지를 쓴다).
