def load_map():
    return json.loads((HERE / 'test-map.json').read_text())


def go_module():
    m = re.search(r'^module (\S+)', (ROOT / 'go.mod').read_text(), re.M)
    return m.group(1)


def go_packages(files):
    """모든 Go 패키지 디렉터리와 그 import(모듈 안쪽만). 정규식으로 읽는다."""
    mod = go_module()
    pk = {}
    for f in files:
        if f.endswith('.go'):
            pk.setdefault(os.path.dirname(f) or '.', []).append(f)
    graph = {}
    imp = re.compile(r'"' + re.escape(mod) + r'(/[^"]*)?"')
    for d, fs in pk.items():
        deps = set()
        for f in fs:
            text = (ROOT / f).read_text(errors='replace')
            m = re.search(r'^import\s*\((.*?)^\)', text, re.M | re.S)
            blocks = [m.group(1)] if m else []
            blocks += re.findall(r'^import\s+(?:\w+\s+)?"[^"]+"', text, re.M)
            for b in blocks:
                for x in imp.finditer(b):
                    deps.add((x.group(1) or '').lstrip('/') or '.')
        deps.discard(d)
        graph[d] = deps
    return pk, graph


def defined_names(path):
    text = (ROOT / path).read_text(errors='replace') if (ROOT / path).exists() else ''
    names = set(re.findall(r'^func (?:\([^)]*\) )?(\w+)', text, re.M))
    names |= set(re.findall(r'^(?:type|var|const) (\w+)', text, re.M))
    return {n for n in names if len(n) >= 6 and not n.startswith('Test')}


def test_funcs(path):
    text = (ROOT / path).read_text(errors='replace') if (ROOT / path).exists() else ''
    return re.findall(r'^func (Test\w+)\(', text, re.M)


# 어느 변경이 이 패키지의 시험 전체를 돌리게 하는 파일
GO_WIDE_PATHS = ['queries/**', 'schema.sql', 'static/email-templates/**', 'i18n/**', 'permissions.json', 'go.mod', 'go.sum']


def embedding_packages(f, pk):
    """f(Go 파일이 아님)를 `//go:embed` 로 담는 패키지 디렉터리들."""
    out = []
    for d, gofiles in pk.items():
        if d != '.' and not f.startswith(d + '/'):
            continue
        rel = f if d == '.' else f[len(d) + 1:]
        for gf in gofiles:
            for m in re.finditer(r'^//go:embed\s+(.+)$', (ROOT / gf).read_text(errors='replace'), re.M):
                for pat in m.group(1).split():
                    pat = pat.strip('"`').rstrip('/')
                    if pat.startswith('all:'):
                        pat = pat[4:]
                    if fnmatch.fnmatch(rel, pat) or rel.startswith(pat + '/'):
                        out.append(d)
                        break
                else:
                    continue
                break
            else:
                continue
            break
    return out


def merge_go(cur, extra):
    """Go 선택 두 개를 합친다. 한쪽이 패키지 전체(None)면 전체, 둘 다 -run 패턴이면 합집합."""
    out = dict(cur)
    for d, run in extra.items():
        if d not in out:
            out[d] = run
        elif out[d] is None or run is None:
            out[d] = None
        elif out[d] == '^$':
            out[d] = run
        elif run != '^$':
            names = set(re.findall(r'\w+', out[d])) | set(re.findall(r'\w+', run))
            out[d] = '^(' + '|'.join(sorted(names)) + ')$'
    return out


def select_go(changed, files):
    """바뀐 파일에서 돌릴 Go 패키지와 -run 패턴을 낸다."""
    pk, graph = go_packages(files)
    rev = {}
    for d, deps in graph.items():
        for x in deps:
            rev.setdefault(x, set()).add(d)
    notes = []
    direct, narrow = {}, {}
    whole = set()  # 임베드 파일이 바뀌어 좁히지 않고 전체를 돌리는 패키지
    wide = False
    for f in changed:
        if f.endswith('.go'):
            d = os.path.dirname(f) or '.'
            if d not in pk:
                continue
            direct.setdefault(d, []).append(f)
        elif match_any(f, GO_WIDE_PATHS):
            wide = True
        else:
            for d in embedding_packages(f, pk):
                direct.setdefault(d, [])
                whole.add(d)
                notes.append(f'{d}: {f} 를 go:embed 하는 패키지라 전체')
    if wide:
        for d in ('cmd', 'internal/core'):
            if d in pk:
                direct.setdefault(d, [])
                notes.append(f'{d}: 쿼리·스키마·번역·템플릿 변경이라 패키지 전체')
    pkgs = {}
    for d, fs in direct.items():
        pkgs[d] = None  # None = 패키지 전체
    # 좁히기: cmd·internal/core 에서 바뀐 파일이 전부 axm_<기능>*.go 일 때만
    for d, fs in direct.items():
        if d not in ('cmd', 'internal/core') or not fs:
            continue
        if wide or d in whole:
            continue
        stems = []
        for f in fs:
            b = os.path.basename(f)
            m = re.match(r'(axm_[a-z0-9]+(?:_[a-z0-9]+)*?)(?:_db)?(?:_test)?\.go$', b)
            if not m:
                stems = None
                break
            stems.append((f, m.group(1)))
        if not stems:
            continue
        tests = set()
        names = set()
        for f, _ in stems:
            names |= defined_names(f)
        for f, stem in stems:
            for t in pk[d]:
                if not t.endswith('_test.go'):
                    continue
                bt = os.path.basename(t)
                if bt.startswith(stem) or any(re.search(r'\b' + re.escape(n) + r'\b', (ROOT / t).read_text(errors='replace')) for n in names):
                    tests.add(t)
        funcs = sorted({fn for t in tests for fn in test_funcs(t)})
        if funcs:
            pkgs[d] = '^(' + '|'.join(funcs) + ')$'
            narrow[d] = len(funcs)
        else:
            pkgs[d] = '^$'
            notes.append(f'{d}: 바뀐 파일에 닿는 시험이 없어 컴파일만 확인')
    # 거꾸로 import 하는 패키지는 전체
    seen = set(pkgs)
    queue = list(direct)
    while queue:
        d = queue.pop()
        for r in rev.get(d, ()):
            # 의존하는 패키지가 바뀌면 그 패키지를 import 하는 쪽은 (직접 바뀐 파일이 있어도) 전체를 돈다.
            pkgs[r] = None
            if r not in seen:
                seen.add(r)
                queue.append(r)
    # 시험 파일이 없는 패키지 제외
    out = {}
    for d, run in pkgs.items():
        if any(t.endswith('_test.go') for t in pk.get(d, [])):
            out[d] = run
    return out, notes


def base_ref(arg):
    if arg:
        return arg
    for r in (DEFAULT_BASE_REF, 'axm/v6.2'):
        if subprocess.run(['git', '-C', str(ROOT), 'rev-parse', '--verify', '-q', r], capture_output=True).returncode == 0:
            return r
    raise SystemExit('비교할 기준 브랜치를 못 찾았다: --base REF 를 준다.')


def changed_since_base(ref):
    mb = git('merge-base', 'HEAD', ref).strip()
    names = set(git('diff', '--name-only', '-z', mb).split('\0')) | set(git('ls-files', '-o', '--exclude-standard', '-z').split('\0'))
    return sorted(n for n in names if n)


def fixture_users(name):
    """픽스처 이름(fixtures/ 아래 경로)을 글자 그대로 담은 spec 파일 이름들."""
    out = []
    for p in sorted((ROOT / 'frontend/cypress/e2e').glob('*.cy.js')):
        try:
            if name in p.read_text(errors='replace'):
                out.append(p.name)
        except OSError:
            pass
    return out


def affected(changed, files, tmap=None):
    """바뀐 파일 묶음 → 돌릴 시험. 순수 함수(단위시험 대상)."""
    tmap = tmap or load_map()
    smoke = tmap['smoke']
    specs, notes, unmapped = [], [], []
    full_build = False
    shared_hit = False
    docs_only = True
    unit = False
    spec_dir = 'frontend/cypress/e2e/'
    fixture_dir = 'frontend/cypress/fixtures/'
    own_specs = []  # 내용이 바뀐 spec 파일 자체
    ext = unit_external_inputs()
    for f in changed:
        if match_any(f, tmap['none']):
            continue
        docs_only = False
        if any(f == e or (e.endswith('/') and f.startswith(e)) for e in ext):
            unit = True  # 프론트 단위시험이 읽는 서버 파일
        if match_any(f, tmap['full_build']):
            full_build = True
            continue
        if f.startswith(spec_dir) and f.endswith('.cy.js'):
            if (ROOT / f).exists() and os.path.basename(f) in tmap['ci_specs']:
                specs.append(os.path.basename(f))
                own_specs.append(os.path.basename(f))
            elif (ROOT / f).exists():
                notes.append(f'{f}: CI 가 돌리지 않는 spec 이라 로컬에서도 건너뜀')
            continue
        if f.startswith('frontend/tests/') or f.startswith('frontend/src/'):
            unit = True
        hit = False
        for rule in tmap['rules']:
            if match_any(f, rule['paths']):
                specs += rule['specs']
                hit = True
        if match_any(f, tmap['shared']):
            shared_hit = True
            hit = True
        if f.startswith(fixture_dir):
            # 픽스처는 그 파일 이름을 읽는 spec 이 검증한다(cy.fixture·selectFile 경로 등).
            users = fixture_users(f[len(fixture_dir):])
            ci_users = [s for s in users if s in tmap['ci_specs']]
            specs += ci_users
            if ci_users:
                hit = True
            elif users and not hit:
                notes.append(f'{f}: CI 가 돌리지 않는 spec({", ".join(users[:3])})만 써서 로컬에서도 건너뜀')
                hit = True
        if not hit and not f.endswith('_test.go') and not f.startswith('frontend/tests/') and not f.startswith('scripts/axm/'):
            # 어느 목록에도 안 맞는 파일은 조용히 넘기지 않는다(예: 설치에 쓰는 설정 파일).
            unmapped.append(f)
    if shared_hit:
        specs += smoke
        notes.append('공용 파일이 바뀌어 smoke 묶음을 더한다. 전체 e2e 는 PR 의 CI(axm-image)가 돈다.')
    if unmapped:
        specs += smoke
        notes.append('매핑 없음 — scripts/axm/test-map.json 에 줄을 추가하라: ' + ', '.join(unmapped[:8]))
    if full_build:
        specs += smoke
        notes.append('Dockerfile.axm·Makefile·lockfile·entrypoint 변경: `axm build --full` 로 운영 방식 빌드도 1회 돌려라.')
    go_pkgs, go_notes = select_go(changed, files)
    notes += go_notes
    ordered = [s for s in tmap['ci_specs'] if s in set(specs)]
    ordered, deferred = local_specs(ordered, own_specs, tmap)
    if deferred:
        notes.append(f'고른 spec 이 CI 의 spec 전부({len(tmap["ci_specs"])}개)라 로컬에서는 smoke 묶음과 바뀐 spec 만 돈다. '
                     f'나머지 {len(deferred)}개는 PR 의 CI(axm-image)가 판정한다: ' + ', '.join(deferred))
    py = any(f.startswith('scripts/axm/') for f in changed)
    return dict(changed=changed, specs=ordered, deferred_specs=deferred, own_specs=own_specs, go=go_pkgs, unit=unit, full_build=full_build,
                python=py, docs_only=docs_only and not py, notes=notes, unmapped=unmapped)


def local_specs(selected, own, tmap):
    """로컬에서 CI 의 Cypress 전체를 돌리지 않는다(AGENTS.md 규칙 1·2).
    고른 것이 CI spec 전부면 smoke 묶음 + 내용이 바뀐 spec 만 돌리고 나머지는 CI 몫으로 넘긴다."""
    ci = tmap['ci_specs']
    if not set(ci) <= set(selected):
        return selected, []
    keep = set(tmap['smoke']) | set(own)
    if set(ci) <= keep:  # 바뀐 spec 이 이미 전부면 줄일 수 없다(전체를 직접 고친 경우)
        keep = set(tmap['smoke'])
    return [s for s in ci if s in keep], [s for s in ci if s not in keep]


