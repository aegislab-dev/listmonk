             '-v', f'{cache / "gomod"}:/gomod', '-v', f'{cache / "gocache"}:/gocache', '-w', '/src']
    with Slot() as sl:
        say(f'빌드: {"단위시험만" if unit_only else "시험 이미지"} (이메일 빌더 {"있음" if (art / ("eb-" + ebk + ".tar")).exists() else "새로"}, '
            f'프론트 {"있음" if (art / ("fe-" + fek + ".tar")).exists() else "새로"})')
        res = run_container(ctx, 'build', ctx.name('build'), dargs + [base], ['bash', '/axmctx/build.sh'], log_name='build',
                            tee_filter=lambda l: not l.startswith(' ') and ('error' in l.lower() or 'fail' in l.lower() or l.startswith('v')))
    if res['rc'] != 0:
        say(res['text'][-3000:])
        steps.add('빌드', res['wall'], res['cpu'], res['peak'], rc=res['rc'], waited=sl.waited)
        raise StageFailed('빌드 실패')
    rows = marks_to_rows(res)
    named = {r[0]: r for r in rows}
    steps.add('빌드(컨테이너 전체)', res['wall'], res['cpu'], res['peak'], waited=sl.waited)
    for nm, label in (('copy', '  파일 복사'), ('unit', '  프론트 단위시험'), ('eb', '  이메일 빌더 빌드(make)'),
                      ('fe', '  프론트 빌드(make)'), ('gobuild', '  go build(make build)'), ('pack', '  stuffbin 패킹')):
        if nm in named:
            steps.add(label, named[nm][1], named[nm][2])
    if unit_only:
        return None
    # 런타임 이미지: 밖에서 만든 바이너리를 넣는다.
    rt = ctx.run / 'rt'
    shutil.rmtree(rt, ignore_errors=True)
