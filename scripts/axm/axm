def resolve_changed(a, ctx, files, hashes):
    if getattr(a, 'since_last', False):
        st = load_stamp(ctx)
        if st and st.get('files'):
            ch = changed_since_stamp(st, files, hashes)
            say(f'지난 통과 기록 이후 내용이 바뀐 파일 {len(ch)}개 (기준 {time.strftime("%m-%d %H:%M", time.localtime(st["ts"]))})')
            return ch, st
        if st:
            say('지난번이 첫 라운드에서 실패해 통과 기록이 없다. 기준 브랜치와 비교하고 지난번 실패한 시험을 더한다.')
            return changed_since_base(base_ref(getattr(a, 'base', None))), st
        say('통과 기록이 없어 기준 브랜치와 비교한다(첫 라운드).')
    return changed_since_base(base_ref(getattr(a, 'base', None))), None


def select_tests(a, ctx, files, hashes):
    """바뀐 파일(기준 브랜치 또는 지난 통과 기록 이후)과 지난번 실패한 시험에서 이번에 돌릴 것을 고른다."""
    changed, st = resolve_changed(a, ctx, files, hashes)
    res = affected(changed, files)
    if st:
        tmap = load_map()
        failed = set(st.get('failed_specs') or [])
        merged = [x for x in tmap['ci_specs'] if x in set(res['specs']) | set(res['deferred_specs']) | failed]
        res['specs'], res['deferred_specs'] = local_specs(merged, list(res['own_specs']) + sorted(failed), tmap)
        res['go'] = merge_go(res['go'], live_failed_go(st, files))
    return changed, res, st


def live_failed_go(st, files):
    """지난번 실패한 Go 패키지 중 지금도 시험 파일이 있는 것만(지운 패키지를 계속 다시 돌리지 않는다)."""
    tested = {os.path.dirname(f) or '.' for f in files if f.endswith('_test.go')}
    return {d: r for d, r in failed_go_map(st).items() if d in tested}


def cmd_affected(a):
    if a.json:
        OUT[0] = sys.stderr  # 표준 출력에는 JSON 만 낸다
    ctx = Ctx(a.role)
    files = tree_files()
    hashes = hash_files(files)
