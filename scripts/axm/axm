def own_containers(ctx):
    r = docker('ps', '-a', '--format', '{{.Names}}', '--filter', f'name=^{ctx.prefix}-', check=False)
    return [n for n in r.stdout.split() if n.startswith(ctx.prefix + '-')]


def cmd_down(a):
    ctx = Ctx(a.role)
    names = own_containers(ctx)
    for n in names:
        docker('rm', '-f', n, check=False)
    say('내린 컨테이너: ' + (', '.join(names) or '없음'))
    return 0


def cmd_prune(a):
    c = cache_dir()
    limit = time.time() - 14 * 86400
    removed = 0
    art = c / 'art'
    if art.exists():
        for p in art.iterdir():
            if p.name.startswith('.') and p.is_file() and p.stat().st_mtime < time.time() - 3600:
                p.unlink()
                continue
            if p.stat().st_mtime < limit:
                if p.is_dir():
                    shutil.rmtree(p, ignore_errors=True)
                else:
                    p.unlink()
                removed += 1
    say(f'14일 넘은 빌드 산출물 {removed}개 삭제')
    cur = base_tag() if (ROOT / 'frontend/package.json').exists() else ''
    r = docker('image', 'ls', '--format', '{{.Repository}}:{{.Tag}} {{.CreatedAt}}', check=False)
    gone = 0
    for line in r.stdout.splitlines():
        ref = line.split(' ')[0]
        if ref.startswith('listmonk-axm-test:') or (ref.startswith('listmonk-axm-base:') and ref != cur):
            age = docker('image', 'inspect', '-f', '{{.Created}}', ref, check=False).stdout.strip()
            try:
                t = time.mktime(time.strptime(age[:19], '%Y-%m-%dT%H:%M:%S'))
            except ValueError:
                continue
            if t < limit or (ref.startswith('listmonk-axm-base:') and ref != cur and t < time.time() - 86400):
                if docker('rmi', ref, check=False).returncode == 0:
                    gone += 1
    say(f'옛 이미지 {gone}개 삭제')
    return 0


def main():
    ap = argparse.ArgumentParser(prog='axm', description=__doc__.split('\n')[0])
    sub = ap.add_subparsers(dest='cmd', required=True)

    def add(name, fn, help_):
        p = sub.add_parser(name, help=help_)
        p.add_argument('--role', choices=['agent', 'reviewer'], help='리뷰어는 reviewer (이름·포트·통과 기록이 따로다)')
        p.set_defaults(fn=fn)
        return p

    add('base', cmd_base, '시험용 베이스 이미지가 없으면 만든다')
    p = add('build', cmd_build, '시험 이미지를 만든다(캐시 사용). --full 은 운영 방식 docker build')
    p.add_argument('--full', action='store_true')
    p = add('affected', cmd_affected, '바뀐 파일에서 돌릴 시험을 보인다')
    p.add_argument('--base'), p.add_argument('--since-last', action='store_true'), p.add_argument('--json', action='store_true')
    p = add('go-test', cmd_go_test, 'Go 시험(일회용 Postgres 포함)')
    p.add_argument('--affected', action='store_true'), p.add_argument('--base'), p.add_argument('--since-last', action='store_true')
    p.add_argument('packages', nargs='*')
    p = add('e2e', cmd_e2e, 'Cypress 시험')
    p.add_argument('--affected', action='store_true'), p.add_argument('--base'), p.add_argument('--since-last', action='store_true')
    p.add_argument('--all-ci', action='store_true', help='CI 의 13개 spec 전부(평소에는 쓰지 않는다)')
    p.add_argument('--image'), p.add_argument('--profile', action='store_true', help='브라우저 CPU 를 스레드 이름으로 나눈 표를 낸다')
    p.add_argument('--browser', default='electron', choices=['electron', 'chrome'])
    p.add_argument('specs', nargs='*')
    p = add('check', cmd_check, '바뀐 부분만 빌드·Go 시험·Cypress 를 돌리고 표를 낸다')
    p.add_argument('--base'), p.add_argument('--since-last', action='store_true'), p.add_argument('--profile', action='store_true')
    p.add_argument('--full-build', action='store_true', help='affected 가 요구하면 운영 방식 빌드도 돈다')
    p = add('measure', cmd_measure, '기준선 측정(지금 방식)')
    p.add_argument('--build-only', action='store_true')
    p.add_argument('--parts', action='store_true', help='지금 방식의 하위 단계(yarn·빌드·go build·패킹)를 따로 잰다')
    p = add('serve', cmd_serve, '시험 이미지로 앱을 띄워 둔다(화면 캡처용)')
    p.add_argument('--image')
    add('down', cmd_down, '내 컨테이너를 내린다')
    add('prune', cmd_prune, '오래된 캐시·이미지를 지운다')
    a = ap.parse_args()
    rc = a.fn(a)
    sys.exit(rc or 0)


if __name__ == '__main__':
    main()
