class Pg:
    """일회용 Postgres(데이터는 tmpfs). 단계 사이에서 같이 쓰고 끝나면 내린다."""

    def __init__(self, ctx):
        self.ctx = ctx
        self.name = ctx.name('pg')
        self.up = False

    def start(self):
        c = self.ctx
        docker('rm', '-f', self.name, check=False)
        docker('run', '-d', '--name', self.name, '--network', 'host', '--cpus', '2', '--tmpfs', '/var/lib/postgresql/data',
               '-e', 'POSTGRES_PASSWORD=pw', PG_IMAGE, 'postgres', '-p', str(c.pg_port), '-c', 'fsync=off',
               '-c', 'synchronous_commit=off', '-c', 'full_page_writes=off', '-c', 'max_connections=200',
               '-c', 'listen_addresses=127.0.0.1')
        self.up = True
        for _ in range(90):
            if docker('exec', self.name, 'pg_isready', '-h', '127.0.0.1', '-p', str(c.pg_port), check=False).returncode == 0:
                return
            time.sleep(1)
        lg = docker('logs', '--tail', '15', self.name, check=False)
        say((lg.stdout + lg.stderr)[-800:])
        raise StageFailed('Postgres 가 올라오지 않는다')

    def fresh_db(self, db):
        p = str(self.ctx.pg_port)
        for sql in (f'DROP DATABASE IF EXISTS {db}', f'CREATE DATABASE {db}'):
            docker('exec', self.name, 'psql', '-U', 'postgres', '-p', p, '-c', sql)
        return f'postgres://postgres:pw@127.0.0.1:{p}/{db}?sslmode=disable'

    def usage(self):
        cid = container_id(self.name)
        return read_usage(cid) if cid else None

    def stop(self):
        docker('rm', '-f', self.name, check=False)
        self.up = False


