    commit = git('rev-parse', '--short', 'HEAD', check=False).strip() or 'local'
    script = BUILD_SH % dict(mark_fn=MARK_FN, eb=ebk, fe=fek, ut=utk, version=LOCAL_VERSION, commit=commit,
                             unit_only='1' if unit_only else '0')
    (ctxdir / 'build.sh').write_text(script)
    out = ctx.run / 'out'
