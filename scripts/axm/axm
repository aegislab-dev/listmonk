'''


def write_wrap(dirpath):
    p = Path(dirpath) / 'wrap.sh'
    p.write_text(WRAP)
    p.chmod(0o755)
    return p


def limit_args(n=None):
    n = cpus() if n is None else n
    return ['--cpus', str(n)] if n and n > 0 else []


ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')


def run_container(ctx, label, name, docker_args, cmd, log_name=None, quiet=False, tee_filter=None):
    """docker run 을 돌려 벽시계·CPU초·최대코어를 잰다. 로그는 파일에, 끝의 요약만 화면에 낸다.

    돌려주는 값: dict(rc, wall, cpu, peak, marks, log_path, text)"""
    ctxdir = ctx.run / 'ctx'
    ctxdir.mkdir(parents=True, exist_ok=True)
    write_wrap(ctxdir)
    log = ctx.run / f'{log_name or label}.log'
    argv = ['docker', 'run', '--rm', '--name', name, '--entrypoint', '/axmctx/wrap.sh',
            '-v', f'{ctxdir}:/axmctx', *docker_args, *cmd]
    docker('rm', '-f', name, check=False)
    poll = Poller(name=name)
    poll.start()
    t0 = time.time()
    lines = []
    with open(log, 'w') as lf:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors='replace')
        for line in p.stdout:
            lf.write(line)
            lf.flush()
            line = ANSI.sub('', line.rstrip('\n'))
            lines.append(line)
            if not quiet and not line.startswith('AXM_') and (tee_filter is None or tee_filter(line)):
                say('  | ' + line)
        p.wait()
    wall = time.time() - t0
    poll.finish()
    cpu = None
    marks = []
    for line in lines:
        m = re.match(r'AXM_CPU_USEC=(\d+)', line)
        if m:
            cpu = int(m.group(1)) / 1e6
        m = re.match(r'AXM_MARK (\S+) ([\d.]+) (\d+)', line)
        if m:
            marks.append((m.group(1), float(m.group(2)), int(m.group(3)) / 1e6))
    if cpu is None:
        cpu = poll.last()
    return dict(rc=p.returncode, wall=wall, cpu=cpu, peak=poll.peak(), marks=marks, log=log, text='\n'.join(lines))


def marks_to_rows(res, prefix=''):
    """AXM_MARK 쌍(이름:start, 이름:end)에서 하위 단계 행을 만든다."""
    rows, open_ = [], {}
    for name, t, cpu in res['marks']:
        base, _, kind = name.rpartition(':')
        if kind == 'start':
            open_[base] = (t, cpu)
        elif kind == 'end' and base in open_:
            t0, c0 = open_.pop(base)
            rows.append((prefix + base, t - t0, cpu - c0))
    return rows


# ---------------------------------------------------------------- 레거시 docker build 측정

class BuildTracker:
    """legacy docker build 의 'Step N/M'·'Running in <id>' 줄을 읽어 단계별 CPU초를 잰다."""

    def __init__(self):
        self.step = 0
        self.steps = {}  # n -> dict(cmd, t0, t1, ids)
        self.ids = {}
        self.cpu = {}  # id -> max usage
        self.alive = True
        self.th = threading.Thread(target=self._poll, daemon=True)
        self.th.start()

    def _poll(self):
        while self.alive:
            for cid in list(self.ids):
                full = self.ids[cid]
                if full is None:
                    full = container_id(cid)
                    self.ids[cid] = full
                    if full is None:
                        continue
                u = read_usage(full)
                if u is not None:
                    self.cpu[cid] = max(self.cpu.get(cid, 0.0), u)
            time.sleep(0.3)

    def feed(self, line):
        m = re.match(r'Step (\d+)/\d+ : (.*)', line)
        if m:
            n = int(m.group(1))
            if self.step in self.steps:
                self.steps[self.step]['t1'] = time.time()
            self.step = n
            self.steps[n] = dict(cmd=m.group(2)[:60], t0=time.time(), t1=None, ids=[])
            return
        if line.strip() == '---> Using cache' and self.step in self.steps:
            self.steps[self.step]['cached'] = True
            return
        m = re.match(r'\s*---> Running in ([0-9a-f]{12})', line)
        if m and self.step in self.steps:
            self.ids[m.group(1)] = None
            self.steps[self.step]['ids'].append(m.group(1))

    def done(self):
        if self.step in self.steps and self.steps[self.step]['t1'] is None:
            self.steps[self.step]['t1'] = time.time()
        time.sleep(0.5)
        self.alive = False
        self.th.join(timeout=2)
        rows = []
        for n, s in sorted(self.steps.items()):
            cpu = sum(self.cpu.get(i, 0.0) for i in s['ids'])
            rows.append((n, s['cmd'], (s['t1'] or time.time()) - s['t0'], cpu))
        return rows


def docker_build(ctx, label, args, context, log_name=None):
    """legacy builder 로 docker build 를 하고 Dockerfile 단계별 시간·CPU초를 돌려준다."""
    log = ctx.run / f'{log_name or label}.log'
    quota = ['--cpu-period', '100000', '--cpu-quota', str(100000 * cpus())] if cpus() > 0 else []
    argv = ['docker', 'build', '--network', 'host', *quota, *args, str(context)]
    tr = BuildTracker()
    t0 = time.time()
    with open(log, 'w') as lf:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors='replace')
        for line in p.stdout:
            lf.write(line)
            lf.flush()
            tr.feed(ANSI.sub('', line.rstrip('\n')))
        p.wait()
    wall = time.time() - t0
    return build_result(tr, tr.done(), p.returncode, wall, log)


def build_result(tr, rows, rc, wall, log):
    run_steps = sum(1 for s in tr.steps.values() if s['ids'])
    cached = sum(1 for s in tr.steps.values() if s.get('cached'))
    # 단계 줄을 하나도 못 읽었으면(예: -q, BuildKit 출력) 잴 수 없었던 것이지 0 이 아니다.
    # RUN 컨테이너의 cgroup 을 한 번도 못 읽은 단계도 0 이 아니라 '못 잼'이다.
    missed = sum(1 for s in tr.steps.values() if s['ids'] and not any(i in tr.cpu for i in s['ids']))
    cpu = sum(r[3] for r in rows) if rows and not (run_steps and missed == run_steps) else None
    if not rows:
        note = 'Dockerfile 단계를 못 읽어 CPU 미측정'
    else:
        note = f'Dockerfile {len(rows)}단계: RUN {run_steps - missed}/{run_steps}개 잼, 캐시 {cached}개'
    return dict(rc=rc, wall=wall, cpu=cpu, steps=rows, log=log, note=note, run_steps=run_steps, cached=cached)


# ---------------------------------------------------------------- 공유 캐시: 베이스 이미지

def stuffbin_version():
    m = re.search(r'github.com/knadh/stuffbin (v[\w.\-]+)', (ROOT / 'go.mod').read_text())
    if not m:
        raise SystemExit('go.mod 에서 stuffbin 버전을 못 찾았다')
    return m.group(1)


DEPS_FILES = ['frontend/package.json', 'frontend/yarn.lock', 'frontend/email-builder/package.json',
              'frontend/email-builder/yarn.lock']


def base_tag():
    parts = [(ROOT / f).read_bytes() for f in DEPS_FILES]
    parts += [(HERE / 'base.Dockerfile').read_bytes(), stuffbin_version(), GO_IMAGE]
    return 'listmonk-axm-base:' + digest(*parts)[:12]


def ensure_base(ctx, steps=None):
    tag = base_tag()
    if image_exists(tag):
        return tag
    with FileLock('base-' + tag.split(':')[1] + '.lock'):
        if image_exists(tag):  # 기다리는 동안 다른 태스크가 만들었다
            say(f'베이스 이미지 {tag} 는 다른 태스크가 만들어 두었다.')
            return tag
        say(f'시험용 베이스 이미지 {tag} 를 만든다(처음 한 번만, 의존성 변경 때 다시).')
        bctx = ctx.run / 'base-ctx'
        shutil.rmtree(bctx, ignore_errors=True)
        for f in DEPS_FILES:
            (bctx / f).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(ROOT / f, bctx / f)
        shutil.copy(HERE / 'base.Dockerfile', bctx / 'Dockerfile')
        with Slot() as sl:
            res = docker_build(ctx, 'base', ['-t', tag, '--build-arg', f'STUFFBIN_VERSION={stuffbin_version()}',
                                             '--build-arg', f'GO_IMAGE={GO_IMAGE}'], bctx)
        if res['rc'] != 0:
            raise SystemExit(f'베이스 이미지 빌드 실패: {res["log"]}')
        if steps is not None:
            steps.add('베이스 이미지(캐시 없을 때만)', res['wall'], res['cpu'], waited=sl.waited)
        return tag


