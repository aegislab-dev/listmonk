def stamp_path(ctx):
    b = re.sub(r'[^A-Za-z0-9_.-]', '_', branch_name())
    return cache_dir() / 'stamps' / f'{ctx.n}-{b}' / f'{ctx.role}.json'


def load_stamp(ctx):
    try:
        return json.loads(stamp_path(ctx).read_text())
    except (OSError, ValueError):
        return None


def save_stamp(ctx, data):
    p = stamp_path(ctx)
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    tmp.replace(p)


def failed_go_map(st):
    fg = st.get('failed_go') or {}
    return fg if isinstance(fg, dict) else {d: None for d in fg}


def changed_since_stamp(stamp, files, hashes):
    old = stamp['files']
    ch = [f for f in files if old.get(f) != hashes[f]]
    ch += [f for f in old if f not in hashes]
    return sorted(set(ch))


# ---------------------------------------------------------------- Go 시험

def go_failures(pkgs, text, rc):
    """go test 출력에서 실패한 패키지만 고른다({디렉터리: -run}). 'ok  <모듈>/<디렉터리>' 줄이 없는 패키지가 실패다."""
    if rc == 0:
        return {}
    mod = go_module()
    passed = set()
    for line in text.splitlines():
        m = re.match(r'ok\s+(\S+)', line)
        if m:
            path = m.group(1)
            passed.add('.' if path == mod else path[len(mod) + 1:] if path.startswith(mod + '/') else path)
    failed = {d: r for d, r in pkgs.items() if d not in passed}
    return failed or dict(pkgs)  # 어느 패키지인지 못 가리면 전부


def go_test(ctx, steps, pkgs, pg, tag=''):
    """pkgs: {패키지 디렉터리: -run 패턴 또는 None}. 같은 -run 이 아니면 패키지별로 나눠 한 번의 컨테이너에서 순서대로 돈다.
    실패한 패키지를 {디렉터리: -run} 으로 돌려준다(통과면 빈 dict)."""
    if not pkgs:
        return {}
    cache = Path(os.environ.get('AXM_GO_CACHE') or cache_dir())
    (cache / 'gomod').mkdir(parents=True, exist_ok=True)
    (cache / 'gocache').mkdir(parents=True, exist_ok=True)
    dsn = pg.fresh_db(f'gotest{ctx.n}')
    n = cpus() or os.cpu_count()
    lines = ['set -uo pipefail', 'fail=0', MARK_FN]
    whole = sorted(d for d, r in pkgs.items() if r is None)
    if whole:
        lines.append(f'mark whole:start; go test -count=1 -timeout 180s -p {n} {" ".join("./" + d if d != "." else "." for d in whole)} || fail=1; mark whole:end')
    for d, r in sorted(pkgs.items()):
        if r is not None:
            lines.append(f"mark {d.replace('/', '_')}:start; go test -count=1 -timeout 180s -p {n} -run '{r}' ./{d} || fail=1; mark {d.replace('/', '_')}:end")
    lines.append('exit $fail')
    (ctx.run / 'ctx').mkdir(parents=True, exist_ok=True)
    (ctx.run / 'ctx' / 'gotest.sh').write_text('\n'.join(lines) + '\n')
    dargs = ['--network', 'host', *limit_args(), '--user', f'{UID}:{GID}', '-v', f'{ROOT}:/src:ro', '-w', '/src',
             '-v', f'{cache / "gomod"}:/gomod', '-v', f'{cache / "gocache"}:/gocache',
             '-e', 'HOME=/tmp', '-e', 'GOCACHE=/gocache', '-e', 'GOMODCACHE=/gomod', '-e', 'GOFLAGS=-buildvcs=false',
             '-e', f'GOMAXPROCS={n}', '-e', f'AXM_TEST_DB_URL={dsn}']
    desc = ', '.join(f'{d}' + ('' if r is None else f'[{len(r.split("|"))}개]') for d, r in sorted(pkgs.items()))
    say(f'Go 시험: {desc}')
    with Slot() as sl:
        res = run_container(ctx, 'gotest', ctx.name('go'), dargs + [GO_IMAGE], ['bash', '/axmctx/gotest.sh'],
                            tee_filter=lambda l: l.startswith(('FAIL', '--- FAIL', 'panic')))
    steps.add('Go 시험' + (f' {tag}' if tag else ''), res['wall'], res['cpu'], res['peak'], note=desc[:40], rc=res['rc'], waited=sl.waited)
    pgcpu = pg.usage()
    if pgcpu is not None:
        steps.add('  (Postgres 컨테이너, 지금까지 누적)', 0, pgcpu)
    failed = go_failures(pkgs, res['text'], res['rc'])
    if failed:
        say('Go 시험 실패(' + ', '.join(sorted(failed)) + '). 로그: ' + str(res['log']))
    for line in res['text'].splitlines():
        if line.startswith('ok '):
            say('  ' + line)
    return failed


# ---------------------------------------------------------------- 브라우저 CPU 분류(스레드 이름)

class Profiler(threading.Thread):
    """컨테이너 cgroup 안의 스레드별 CPU 를 0.5초마다 표본해 묶음별로 합한다."""

    def __init__(self, name=None, interval=0.5, pids_fn=None):
        super().__init__(daemon=True)
        self.name_, self.interval, self.pids_fn = name, interval, pids_fn
        self.cid = None
        self.stop = threading.Event()
        self.prev = {}
        self.acc = {}
        self.by_comm = {}
        self.ptype = {}
        self.hz = os.sysconf('SC_CLK_TCK')

    def classify(self, pid, comm):
        if pid not in self.ptype:
            try:
                cmd = Path(f'/proc/{pid}/cmdline').read_bytes().replace(b'\0', b' ').decode(errors='replace')
            except OSError:
                cmd = ''
            c = Path(f'/proc/{pid}/comm').read_text().strip() if Path(f'/proc/{pid}/comm').exists() else ''
            self.ptype[pid] = (c, cmd)
        pcomm, cmd = self.ptype[pid]
        if pcomm == 'Xvfb':
            return '렌더링 하한: Xvfb'
        if comm == 'CrRendererMain' or (comm == pcomm[:15] and '--type=renderer' in cmd):
            return 'JS·레이아웃(렌더러 메인 스레드)'
        if comm in ('Compositor', 'VizCompositorTh') or comm.startswith('CompositorTileW'):
            return '렌더링 하한: 컴포지터·타일(래스터)'
        if '--type=gpu-process' in cmd or comm in ('CrGpuMain', 'GpuWatchdog', 'GpuMemoryThread'):
            return '렌더링 하한: GPU 프로세스'
        if comm.startswith('ThreadPoolForeg'):
            if '--type=renderer' in cmd or '--type=zygote' in cmd or 'renderer' in cmd:
                return '렌더링 상한 추가분: 렌더러 ThreadPoolForeground'
            return '기타 스레드풀'
        if '--type=utility' in cmd and 'network' in cmd:
            return '네트워크 서비스'
        if pcomm in ('cypress', 'Cypress', 'node') or 'cypress' in cmd.lower() or pcomm.lower().startswith('chrom') or pcomm == 'electron':
            return 'Cypress/브라우저 기타(메인·노드·스레드)'
        return '기타'

    def run(self):
        procs = None
        if self.pids_fn is None:
            while not self.stop.is_set() and self.cid is None:
                self.cid = container_id(self.name_)
                self.stop.wait(0.3)
            procs = scope_dir(self.cid) / 'cgroup.procs'
        while not self.stop.is_set():
            try:
                pids = self.pids_fn() if self.pids_fn else [int(x) for x in procs.read_text().split()]
            except (OSError, ValueError, AttributeError):
                pids = []
            for pid in pids:
                try:
                    tids = os.listdir(f'/proc/{pid}/task')
                except OSError:
                    continue
                for tid in tids:
                    try:
                        st = Path(f'/proc/{pid}/task/{tid}/stat').read_text()
                    except OSError:
                        continue
                    comm = st[st.index('(') + 1:st.rindex(')')]
                    rest = st[st.rindex(')') + 2:].split()
                    ticks = int(rest[11]) + int(rest[12])
                    key = (pid, tid)
                    d = ticks - self.prev.get(key, 0)
                    self.prev[key] = ticks
                    if d > 0:
                        g = self.classify(pid, comm)
                        self.acc[g] = self.acc.get(g, 0) + d
                        tm = re.search(r'--type=([\w-]+)', self.ptype[pid][1])
                        ck = re.sub(r'\d+$', '', comm) + ' [' + (tm.group(1) if tm else self.ptype[pid][0][:12]) + ']'
                        self.by_comm[ck] = self.by_comm.get(ck, 0) + d
            self.stop.wait(self.interval)

    def finish(self):
        self.stop.set()
        self.join(timeout=3)

    def report(self):
        tot = sum(self.acc.values()) or 1
        return {k: (v / self.hz, v / tot) for k, v in sorted(self.acc.items(), key=lambda kv: -kv[1])}


