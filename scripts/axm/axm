def build_full(ctx, steps):
    """운영과 같은 방식: docker build -f Dockerfile.axm (legacy builder, 캐시 없는 단계 포함)."""
    commit = git('rev-parse', '--short', 'HEAD', check=False).strip() or 'local'
    tag = f'listmonk-axm-full:{ctx.n}'
    with Slot() as sl:
        res = docker_build(ctx, 'build-full', ['-f', 'Dockerfile.axm', '--build-arg', f'VERSION={LOCAL_VERSION}',
                                               '--build-arg', f'COMMIT={commit}', '-t', tag], ROOT)
    if res['rc'] != 0:
        say(Path(res['log']).read_text()[-3000:])
        raise StageFailed('Dockerfile.axm 빌드 실패')
    steps.add('Dockerfile.axm 전체 빌드', res['wall'], res['cpu'], waited=sl.waited)
    for n, cmd, wall, cpu in res['steps']:
        if wall > 3 or cpu > 3:
            steps.add(f'  step {n} {cmd[:26]}', wall, cpu)
    return tag


