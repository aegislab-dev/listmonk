CY_ROW = re.compile(r'^[\s│]*([✔✖])\s+(\S+\.cy\.js)\s+(\S+)\s+(\d+|-)\s+(\d+|-)\s+(\d+|-)\s+(\d+|-)\s+(\d+|-)')


def ensure_cy_modules(ctx, steps=None):
    """Cypress spec 의 support 가 쓰는 node_modules 를 베이스 이미지에서 한 번 꺼내 공유 캐시에 둔다."""
    tag = base_tag()
    dest = cache_dir() / 'art' / ('nm-' + tag.split(':')[1])
    if (dest / 'cypress-file-upload').exists():
        return dest
    ensure_base(ctx, steps)
    dest.parent.mkdir(parents=True, exist_ok=True)
    with FileLock('nm-' + tag.split(':')[1] + '.lock'):
        if (dest / 'cypress-file-upload').exists():
            return dest
        tmp = dest.with_name(dest.name + f'.tmp{os.getpid()}')
        shutil.rmtree(tmp, ignore_errors=True)
        name = ctx.name('nm')
        docker('rm', '-f', name, check=False)
        docker('create', '--name', name, tag)
        try:
            docker('cp', f'{name}:/src/frontend/node_modules', str(tmp))
        finally:
            docker('rm', '-f', name, check=False)
        tmp.rename(dest)
    return dest


def start_app(ctx, steps, image, pg):
    """새 DB 설치 → 시험 데이터 적재 → 앱 기동. 앱 컨테이너 이름을 돌려준다."""
    app, port = ctx.name('app'), ctx.app_port
    dsn_db = f'e2e{ctx.n}'
    pg.fresh_db(dsn_db)
    env = {'LISTMONK_db__host': '127.0.0.1', 'LISTMONK_db__port': str(ctx.pg_port), 'LISTMONK_db__user': 'postgres',
           'LISTMONK_db__password': 'pw', 'LISTMONK_db__database': dsn_db, 'LISTMONK_db__ssl_mode': 'disable',
           'LISTMONK_app__address': f'127.0.0.1:{port}', 'LISTMONK_ADMIN_USER': 'ci-admin',
           'LISTMONK_ADMIN_PASSWORD': 'ci-only-password'}
    eargs = [x for k, v in env.items() for x in ('-e', f'{k}={v}')]
    t0 = time.time()
    r = docker('run', '--rm', '--network', 'host', *eargs, image, './listmonk', '--install', '--yes', check=False)
    if r.returncode != 0:
        say((r.stdout + r.stderr)[-1500:])
        raise StageFailed('앱 설치(--install) 실패')
    fx = (ROOT / 'frontend/cypress/fixtures/reaction-lists.sql').read_text()
    pr = subprocess.run(['docker', 'exec', '-i', pg.name, 'psql', '-v', 'ON_ERROR_STOP=1', '-U', 'postgres', '-p', str(ctx.pg_port), '-d', dsn_db],
                        input=fx, capture_output=True, text=True)
    if pr.returncode != 0:
        raise StageFailed('reaction-lists.sql 적재 실패: ' + pr.stderr[-300:])
    docker('rm', '-f', app, check=False)
    docker('run', '-d', '--name', app, '--network', 'host', *limit_args(2), *eargs, image)
    ok = False
    for _ in range(60):
        if subprocess.run(['curl', '-sf', f'http://127.0.0.1:{port}/health'], capture_output=True).returncode == 0:
            ok = True
            break
        time.sleep(1)
    if not ok:
        say(docker('logs', app, check=False).stdout[-1500:] + docker('logs', app, check=False).stderr[-500:])
        docker('rm', '-f', app, check=False)
        raise StageFailed('앱이 /health 에 답하지 않는다')
    steps.add('e2e 준비(DB 설치·앱 기동)', time.time() - t0, None)
    return app


def e2e(ctx, steps, specs, image, pg, profile=False, browser='electron', extra_env=None, extra_dargs=None):
    """시험 이미지로 새 DB 설치 → 앱 기동 → Cypress. 끝나면 성공·실패와 무관하게 앱을 내린다."""
    if not specs:
        return True, [], []
    app = start_app(ctx, steps, image, pg)
    try:
        return _e2e_run(ctx, steps, specs, app, profile, browser, extra_env, extra_dargs)
    finally:
        docker('rm', '-f', app, check=False)


def _e2e_run(ctx, steps, specs, app, profile, browser, extra_env, extra_dargs):
    port = ctx.app_port
    cyhome = ctx.run / 'cyhome'
    cyhome.mkdir(parents=True, exist_ok=True)
    (ctx.run / 'ctx').mkdir(parents=True, exist_ok=True)
    nm = ensure_cy_modules(ctx, steps)
    proj = ctx.run / 'cy-proj'
    shutil.rmtree(proj, ignore_errors=True)
    proj.mkdir(parents=True)
    shutil.copytree(ROOT / 'frontend/cypress', proj / 'cypress')
    for f in ('cypress.config.js', 'package.json'):
        shutil.copy(ROOT / 'frontend' / f, proj / f)
    spec_arg = ','.join('cypress/e2e/' + s for s in specs)
    sh = (f'Xvfb :{ctx.display} -screen 0 1600x1200x24 -nolisten tcp & sleep 2; '
          f'{MARK_FN} mark cy:start; DISPLAY=:{ctx.display} cypress run --browser {browser} '
          f'--config baseUrl=http://127.0.0.1:{port},video=false '
          f"--spec '{spec_arg}'; rc=$?; mark cy:end; exit $rc")
    (ctx.run / 'ctx' / 'cy.sh').write_text(sh + '\n')
    dargs = ['--network', 'host', *limit_args(), '--shm-size', '1g', '--user', f'{UID}:{GID}', '-e', 'HOME=/tmp/cyhome', '-e', 'NO_COLOR=1',
             '-v', f'{cyhome}:/tmp/cyhome', '-v', f'{proj}:/e2e', '-v', f'{nm}:/e2e/node_modules:ro', '-w', '/e2e',
             '-e', 'CYPRESS_LISTMONK_ADMIN_USER=ci-admin', '-e', 'CYPRESS_LISTMONK_ADMIN_PASSWORD=ci-only-password',
             '-e', f'CYPRESS_apiUrl=http://127.0.0.1:{port}']
    for k, v in (extra_env or {}).items():
        dargs += ['-e', f'{k}={v}']
    dargs += extra_dargs or []
    prof = Profiler(ctx.name('cy')) if profile else None
    if prof:
        prof.start()
    say(f'Cypress: {len(specs)}개 spec — ' + ', '.join(s.replace('.cy.js', '') for s in specs))
    try:
        with Slot() as sl:
            res = run_container(ctx, 'cypress', ctx.name('cy'), dargs + [CYPRESS_IMAGE], ['bash', '/axmctx/cy.sh'],
                                tee_filter=lambda l: bool(CY_ROW.match(l)) or 'failing' in l or 'Error' in l[:40] or l.strip().startswith(('1)', '2)', '3)')))
    finally:
        if prof:
            prof.finish()
        appcpu = read_usage(container_id(app) or '')
    passed, failed = [], []
    for line in res['text'].splitlines():
        m = CY_ROW.match(line)
        if m:
            (passed if m.group(1) == '✔' else failed).append(m.group(2))
    steps.add('Cypress', res['wall'], res['cpu'], res['peak'], note=f'{len(passed)}통과 {len(failed)}실패', rc=res['rc'], waited=sl.waited)
    if appcpu is not None:
        steps.add('  (listmonk 앱 컨테이너)', 0, appcpu)
    if prof:
        say('\n-- 브라우저 컨테이너 CPU 를 스레드 이름으로 나눈 표(Cypress 컨테이너 안) --')
        for k, (s, share) in prof.report().items():
            say(f'  {k:<44}{s:>8.1f}s {share * 100:>5.1f}%')
        say('  스레드 이름별 상위(분류 확인용):')
        for k, v in sorted(prof.by_comm.items(), key=lambda kv: -kv[1])[:14]:
            say(f'    {k:<40}{v / prof.hz:>8.1f}s')
    if res['rc'] != 0 and not failed:
        say(res['text'][-2500:])
    if res['rc'] != 0:
        say('Cypress 실패. 로그: ' + str(res['log']))
    ok = res['rc'] == 0
    return ok, passed, failed


