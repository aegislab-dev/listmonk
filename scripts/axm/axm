def build_inputs():
    files = tree_files()
    hashes = hash_files(files)
    return files, hashes


def recipe_digest():
    """이미지·산출물을 만드는 방법(베이스 이미지 태그, Dockerfile 두 개, 빌드 스크립트)이 바뀌면 키가 바뀐다."""
    return digest(base_tag(), (HERE / 'base.Dockerfile').read_bytes(), (HERE / 'runtime.Dockerfile').read_bytes(),
                  BUILD_SH, LOCAL_VERSION)[:16]


def image_key(files, hashes):
    return digest(key_of([f for f in files if not match_any(f, IMAGE_KEY_EXCLUDE)], hashes), recipe_digest())[:16]


def unit_external_inputs():
    """frontend/tests 가 `new URL('../../…')` 로 읽는 프론트 밖 파일(디렉터리는 끝에 /). 이 파일들이 바뀌면 단위시험을 다시 돈다."""
    out = set()
    for t in sorted((ROOT / 'frontend/tests').glob('*.mjs')):
        for m in re.finditer(r"new URL\(\s*[`'\"]([^`'\"]*)", t.read_text(errors='replace')):
            rel = m.group(1)
            if not rel.startswith('../../'):
                continue
            path = rel[len('../../'):]
            if '${' in path:
                path = path[:path.index('${')]
                path = path[:path.rfind('/') + 1] if '/' in path else path
            out.add(path)
    return sorted(out)


def unit_inputs(files):
    ext = unit_external_inputs()
    return [f for f in files if (f.startswith('frontend/') and not f.startswith('frontend/email-builder/')
                                 and not f.startswith('frontend/cypress/'))
            or any(f == e or (e.endswith('/') and f.startswith(e)) for e in ext)]


def art_keys(files, hashes):
    eb = [f for f in files if f.startswith('frontend/email-builder/') and not f.endswith('yarn.lock')]
    eb += [f for f in files if f == 'frontend/email-builder/yarn.lock']
    fe = [f for f in files if f.startswith('frontend/') and not f.startswith('frontend/email-builder/')
          and not f.startswith('frontend/cypress/') and not f.startswith('frontend/tests/')]
    ut = unit_inputs(files)
    tool = digest(base_tag(), (HERE / 'base.Dockerfile').read_bytes(), LOCAL_VERSION)
    ebk = digest(key_of(eb, hashes), tool)[:16]
    fek = digest(key_of(fe, hashes), ebk, LOCAL_VERSION)[:16]
    utk = digest(key_of(ut, hashes), ebk)[:16]
    return ebk, fek, utk


